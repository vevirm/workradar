{
  "topic": "Future of work, with a standing focus on hybrid and remote working",
  "config_version": "1.0.0",
  "scan_budget_seconds": 600,
  "scan_finalize_reserve_seconds": 45,
  "network_reserve_seconds": 30,
  "request_timeout_seconds": 12,
  "scholarly_api_timeout_seconds": 12,
  "institution_page_timeout_seconds": 12,
  "sitemap_timeout_seconds": 10,
  "openalex_stage_seconds": 135,
  "crossref_stage_seconds": 150,
  "institution_stage_seconds": 160,
  "backfill_stage_seconds": 90,
  "openalex_workers": 4,
  "crossref_workers": 4,
  "institution_discovery_workers": 8,
  "institution_page_workers": 12,
  "openalex_min_interval_seconds": 0.35,
  "crossref_min_interval_seconds": 0.45,
  "public_retries": 2,
  "public_429_cooldown_seconds": 6,
  "openalex_per_query": 60,
  "openalex_queries_per_scan": 14,
  "openalex_depth_pages_max": 4,
  "crossref_rows_per_query": 60,
  "crossref_queries_per_scan": 12,
  "crossref_journals_per_scan": 10,
  "crossref_journal_rows": 40,
  "institution_sources_per_scan": 9,
  "institution_pages_per_domain": 14,
  "sitemap_max_entries": 900,
  "institution_min_words": 400,
  "lookback_months": 30,
  "extended_top_quality_lookback_months": 48,
  "discovery_overlap_days": 21,
  "max_corpus_items": 0,
  "target_new_items_per_scan": 18,
  "low_yield_rescue_trigger_max_new": 4,
  "low_yield_rescue_stage_seconds": 90,
  "low_yield_rescue_min_seconds_remaining": 120,
  "english_only": true,
  "skip_known_items_before_classification": true,
  "institution_seen_cache_max": 4000,
  "admission_policy": "An item is admitted only when the text carries (1) work/employment aboutness, (2) explicit hybrid/remote/on-site location-of-work evidence, and (3) a recognised top-tier journal or a listed government/institutional publisher. Matrix placement is a separate, stricter evidence test and never a condition of admission: unplaced items stay in the corpus and are shown in the holding bay.",
  "matrix_policy": "The horizontal axis records which working arrangement the evidence actually speaks to: remote and hybrid on one side, on-site and return-to-office on the other. Explicit return-to-office and mandate language is weighted more heavily than passing mentions of an office. The vertical axis reads effectiveness compositionally: a valence word is paired with an outcome noun within a short window, and the noun's orientation decides the sign, so reduced turnover counts as higher effectiveness while reduced productivity counts as lower. Negation is scoped to the clause before each match, and null markers such as 'unaffected' or 'mixed findings' suppress a pair rather than voting. Placement needs a margin on both axes and at least one sentence where arrangement and outcome co-occur. Items that meet only one axis are held as unplaced rather than guessed into a cell.",
  "matrix_axes": {
    "x": {
      "name": "Arrangement the evidence speaks to",
      "low": "less_remote",
      "high": "more_remote",
      "low_label": "On-site / return to office",
      "high_label": "Remote / hybrid"
    },
    "y": {
      "name": "Effect on effectiveness",
      "low": "lower_effectiveness",
      "high": "higher_effectiveness",
      "low_label": "Lower effectiveness",
      "high_label": "Higher effectiveness"
    }
  },
  "matrix_cells": {
    "more_remote-higher_effectiveness": {
      "label": "Distributed gain",
      "reading": "Studies remote or hybrid working and finds effectiveness holds up or improves."
    },
    "more_remote-lower_effectiveness": {
      "label": "Distance cost",
      "reading": "Studies remote or hybrid working and finds effectiveness falls."
    },
    "less_remote-higher_effectiveness": {
      "label": "Proximity premium",
      "reading": "Studies on-site or return-to-office working and finds effectiveness improves."
    },
    "less_remote-lower_effectiveness": {
      "label": "Return-to-office drag",
      "reading": "Studies on-site or return-to-office working and finds effectiveness falls."
    }
  },
